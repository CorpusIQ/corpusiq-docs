{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hermes/:path*",
      "destination": "/docs/hermes/:path*",
      "statusCode": 301
    },
    {
      "source": "/assets/:path*",
      "destination": "/docs/assets/:path*",
      "statusCode": 301
    },
    {
      "source": "/javascripts/:path*",
      "destination": "/docs/javascripts/:path*",
      "statusCode": 301
    },
    {
      "source": "/stylesheets/:path*",
      "destination": "/docs/stylesheets/:path*",
      "statusCode": 301
    }
  ],
  "buildCommand": "python3 -m mkdocs build --clean && python3 scripts/inject_structured_data.py",
  "installCommand": "pip install -r requirements.txt"
}